generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model admin_user {
  id_user       BigInt    @id @default(autoincrement())
  name          String?   @db.VarChar(255)
  surname       String?   @db.VarChar(255)
  username      String?   @db.VarChar(255)
  password      String?   @db.VarChar(255)
  ip_connection String?   @db.VarChar(255)
  auth_token    String?
  is_active     Boolean?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model client_credentials {
  id_client_credential                BigInt    @id @default(autoincrement())
  id_client                           BigInt?
  username                            String?   @db.VarChar(255)
  password                            String?
  ip_connection                       String?   @db.VarChar(255)
  assign_credentials_token_jti        String?   @db.VarChar(50)
  auth_token                          String?
  recovery_token                      String?
  created_at                          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime? @default(now()) @db.Timestamptz(6)
  checked_credential_assignment_token Boolean?  @default(false)
}

model clients {
  id_client           BigInt    @id @default(autoincrement())
  id_client_state     Int?      @db.SmallInt
  id_type             Int?      @db.SmallInt
  id_number           String?   @db.VarChar(50)
  name                String?   @db.VarChar(255)
  email               String?   @db.VarChar(255)
  cell_callsign       String?   @db.VarChar(5)
  cell_phone          String?   @db.VarChar(255)
  user_first_name     String?   @db.VarChar(255)
  user_second_name    String?   @db.VarChar(255)
  user_first_surname  String?   @db.VarChar(255)
  user_second_surname String?   @db.VarChar(255)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
}

model diffusion_information {
  id_diffusion_information  BigInt    @id @default(autoincrement())
  id_client                 BigInt?
  sender_email              String?   @db.VarChar(255)
  mail_application_password String?
  id_smtp_server            BigInt?
  client_id                 String?   @db.VarChar(255)
  client_secret             String?   @db.VarChar(255)
  tenant_id                 String?   @db.VarChar(255)
  refresh_token             String?
  is_default                Boolean?
  created_at                DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                DateTime? @default(now()) @db.Timestamptz(6)
}

model nexlify_keys {
  id_nexlify_key BigInt    @id @default(autoincrement())
  id_client      BigInt?
  api_key        String?
  state          Boolean?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}

model nexlify_keys_logs {
  id_nexlify_key_log BigInt    @id @default(autoincrement())
  id_client          BigInt?
  api_key            String?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
}

model smtp_servers {
  id_smpt_server BigInt    @id @default(autoincrement())
  provider       String?   @db.VarChar(50)
  host           String?   @db.VarChar(50)
  port           Int?      @db.SmallInt
  auth_type      String    @default("basic") @db.VarChar(20)
  state          Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}

model templates {
  id_template String    @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  name        String?   @db.VarChar(50)
  subject     String?   @db.VarChar(255)
  template    String?
  is_active   Boolean?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model users {
  id_user        BigInt    @id @default(autoincrement())
  id_client      BigInt?
  id_type        Int?      @db.SmallInt
  id_number      String?   @db.VarChar(50)
  first_name     String?   @db.VarChar(255)
  second_name    String?   @db.VarChar(255)
  first_surname  String?   @db.VarChar(255)
  second_surname String?   @db.VarChar(255)
  email          String?   @db.VarChar(255)
  cell_callsign  String?   @db.VarChar(5)
  cell_phone     String?   @db.VarChar(255)
  birthdate      DateTime? @db.Date
  state          Boolean?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}

model nexlify_configuration {
  id_configuration          BigInt    @id @default(autoincrement())
  sender_email              String    @db.VarChar(255)
  sender_name               String?   @db.VarChar(255)
  reply_to_email            String?   @db.VarChar(255)
  mail_application_password String?
  id_smtp_server            BigInt?
  client_id                 String?   @db.VarChar(255)
  client_secret             String?   @db.VarChar(255)
  tenant_id                 String?   @db.VarChar(255)
  refresh_token             String?
  daily_send_limit          Int?      @default(500)
  max_retries               Int?      @default(3) @db.SmallInt
  retry_interval_seconds    Int?      @default(60) @db.SmallInt
  email_header_text         String?
  email_header_html         String?
  email_header_img_url      String?
  email_footer_text         String?
  email_footer_html         String?
  email_footer_img_url      String?
  created_at                DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                DateTime? @default(now()) @db.Timestamptz(6)
}

model id_types {
  id_type     Int       @id @default(autoincrement()) @db.SmallInt
  code        String    @unique @db.VarChar(10)
  name        String    @db.VarChar(255)
  description String?
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
}

enum EmailDirection {
  SENT
  RECEIVED
}

enum EmailState {
  QUEUED
  SENDING
  SENT
  WARNING
  FAILED
  RETRYING
  RECEIVED
}

enum EmailLogLevel {
  SUCCESS
  WARNING
  ERROR
}

model emails {
  id_email    BigInt     @id @default(autoincrement())
  email_uuid  String     @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  short_code  String     @unique @db.VarChar(20)
  id_client   BigInt?
  from_email  String     @db.VarChar(255)
  to_email    String     @db.VarChar(1000)
  subject     String     @db.VarChar(255)
  body_html   String?
  body_text   String?
  state       EmailState @default(QUEUED)
  attempts    Int        @default(0)
  next_retry_at DateTime?
  sent_at     DateTime?
  message_id  String?    @db.VarChar(255)
  direction   EmailDirection @default(SENT)
  parent_email_id BigInt?
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)

  @@index([state, next_retry_at])
}

model email_send_logs {
  id_log     BigInt        @id @default(autoincrement())
  id_email   BigInt
  attempt    Int
  level      EmailLogLevel
  message    String
  smtp_host  String?       @db.VarChar(255)
  created_at DateTime?     @default(now()) @db.Timestamptz(6)

  @@index([id_email])
}

model email_attachments {
  id_attachment BigInt    @id @default(autoincrement())
  id_email      BigInt
  filename      String    @db.VarChar(255)
  content_type  String?   @db.VarChar(100)
  size_bytes    Int?
  content       String?   @db.Text
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([id_email])
}

model email_event_subscriptions {
  id_subscription     BigInt    @id @default(autoincrement())
  subscription_uuid   String    @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  id_client           BigInt
  id_webhook_endpoint BigInt
  events              String    @db.VarChar(300)
  include_body        Boolean   @default(false)
  include_dates       Boolean   @default(true)
  include_sender      Boolean   @default(true)
  include_recipients  Boolean   @default(true)
  include_attachments Boolean   @default(false)
  is_active           Boolean   @default(true)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
}

model webhook_endpoints {
  id_endpoint   BigInt    @id @default(autoincrement())
  endpoint_uuid String    @unique @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  id_client     BigInt?
  url           String    @db.VarChar(500)
  secret        String    @db.VarChar(255)
  is_active     Boolean   @default(true)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model webhook_deliveries {
  id_delivery   BigInt    @id @default(autoincrement())
  id_endpoint   BigInt
  id_email      BigInt
  event         String    @db.VarChar(20)
  payload       String?   @db.Text
  attempt       Int       @default(0)
  ok            Boolean?
  status_code   Int?
  error         String?   @db.VarChar(500)
  next_retry_at DateTime?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([next_retry_at])
}
