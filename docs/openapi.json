{
  "openapi": "3.0.3",
  "info": {
    "title": "nexlify-provider API",
    "description": "Provider HTTP de la plataforma Nexlify. Documentación mantenida a mano (contrato versionado en docs/openapi.json) — es la ÚNICA fuente de verdad del API surface, no hay generación automática.\n\nAutenticación: Bearer JWT (sesiones admin y client) o X-API-Key (clientes programáticos) según el endpoint. La sesión de admin queda discriminada por el claim `is_admin` del JWT y nunca colisiona con la tabla clients.",
    "version": "1.0.0",
    "contact": { "name": "Nexlify Platform", "url": "https://localhost:4200" }
  },
  "servers": [
    { "url": "http://localhost:3600", "description": "Desarrollo local" }
  ],
  "tags": [
    { "name": "admin-user", "description": "Autenticación y sesión de administradores de plataforma" },
    { "name": "clients", "description": "Onboarding, ciclo de vida y sesión de clientes" },
    { "name": "email", "description": "Envío, difusión, auditoría y recepción de correos" },
    { "name": "email-events", "description": "Suscripciones a eventos de correo con gating de campos" },
    { "name": "webhooks", "description": "Endpoints webhook de clientes para notificaciones de estado" },
    { "name": "stats", "description": "Métricas del dashboard (totales, tasas, serie diaria, presupuesto)" },
    { "name": "certificates", "description": "Correo certificado: evidencia inmutable, PDF y verificación pública" },
    { "name": "ai", "description": "Inteligencia IA de respuestas (Claude)" },
    { "name": "nexlify-keys", "description": "API keys de clientes programáticos" },
    { "name": "users", "description": "Usuarios finales bajo un cliente" },
    { "name": "templates", "description": "Plantillas de correo" },
    { "name": "configuration", "description": "Configuración global de la plataforma" },
    { "name": "smtp-server", "description": "Catálogo de servidores SMTP" },
    { "name": "master", "description": "Datos maestros" },
    { "name": "verify", "description": "Health check y tokens de asignación" }
  ],
  "paths": {
    "/api/admin-user/auth": {
      "post": {
        "tags": ["admin-user"], "summary": "Login de administrador", "security": [],
        "description": "Devuelve JWT (is_admin: true, con ip_connection de la solicitud). Recuerda: la sesión de admin solo valida contra admin_user.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string", "example": "admin" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "ok + AuthDto { token, ip_connection }" } }
      }
    },
    "/api/admin-user/data": {
      "get": {
        "tags": ["admin-user"], "summary": "Datos de la sesión admin actual", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Datos del admin autenticado desde el contexto de AsyncLocalStorage" } }
      }
    },
    "/api/client/register": {
      "post": {
        "tags": ["clients"], "summary": "Registrar un cliente y enviar por email el link de asignación", "security": [{ "bearerAuth": [] }],
        "description": "Requiere SmtpServerExistsGuard (configuración + servidor SMTP existentes). Envía por correo el link con el token de asignación de credenciales.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "id_type": { "type": "integer" }, "id_number": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string" }, "cell_callsign": { "type": "string" }, "cell_phone": { "type": "string", "description": "Dial string de números par (varios teléfonos). Enviar como texto plano en minúsculas." } } } } } },
        "responses": { "200": { "description": "Cliente creado (estado HABILITACION_PENDIENTE) y correo de asignación enviado" } }
      }
    },
    "/api/client/assign-credentials": {
      "post": {
        "tags": ["clients"], "summary": "Asignar usuario/contraseña desde el token recibido por email", "security": [],
        "description": "Header requerido: `x-assign-creds-token` (token encriptado del email). Activa el cliente (ACTIVO) y emite su API key (hasheada SHA-256) con log de auditoría.",
        "parameters": [ { "name": "x-assign-creds-token", "in": "header", "required": true, "schema": { "type": "string" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "description": "bcrypt (cost 12) al server" } } } } } },
        "responses": { "200": { "description": "Credenciales asignadas y cliente activado" } }
      }
    },
    "/api/client/sign-in": {
      "post": {
        "tags": ["clients"], "summary": "Login de cliente", "security": [],
        "description": "JWT con is_admin:false y binding de IP. El token se guarda cifrado (AES-GCM) en client_credentials. Password verificada con bcrypt (los hashes legacy SHA-256 se migran automáticamente al primer login exitoso).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "AuthDto { token, ip_connection }" }, "403": { "description": "Credenciales inválidas o cliente inactivo" } }
      }
    },
    "/api/client/get-clients": {
      "get": {
        "tags": ["clients"], "summary": "Listado paginado de clientes", "security": [{ "bearerAuth": [] }],
        "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "limit", "in": "query", "schema": { "type": "integer" } }, { "name": "state", "in": "query", "schema": { "type": "integer", "description": "1 ACTIVO, 2 INACTIVO, 3 HABILITACION_PENDIENTE" } }, { "name": "search", "in": "query", "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "PaginateBaseDTO<AllClientsInfoDTO[]>" } }
      }
    },
    "/api/client/detail": {
      "get": {
        "tags": ["clients"], "summary": "Detalle de un cliente", "security": [{ "bearerAuth": [] }],
        "description": "Admin puede consultar cualquiera; un cliente solo a sí mismo (otros devuelven 404 sin revelar existencia).",
        "parameters": [ { "name": "id_client", "in": "query", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "ClientDetailDTO" }, "404": { "description": "No existe o no es propio" } }
      }
    },
    "/api/client/data": {
      "get": {
        "tags": ["clients"], "summary": "Datos de la sesión client actual", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "ClientDataDTO" } }
      }
    },
    "/api/client/update": {
      "put": {
        "tags": ["clients"], "summary": "Actualizar datos de contacto de un cliente", "security": [{ "bearerAuth": [] }],
        "description": "No-admin modifica únicamente su propio cliente; admin pasa id_client en el body.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "id_client": { "type": "integer", "description": "Solo admin" }, "email": { "type": "string" }, "cell_callsign": { "type": "string" }, "cell_phone": { "type": "string" }, "name": { "type": "string" } } } } } },
        "responses": { "200": { "description": "true" } }
      }
    },
    "/api/client/state": {
      "put": {
        "tags": ["clients"], "summary": "Suspender / reactivar cliente (solo admin)", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["id_client", "id_client_state"], "properties": { "id_client": { "type": "integer" }, "id_client_state": { "type": "integer", "enum": [1, 2, 3], "description": "1 ACTIVO, 2 INACTIVO, 3 HABILITACION_PENDIENTE" } } } } } },
        "responses": { "200": { "description": "true" }, "404": { "description": "Cliente no encontrado" } }
      }
    },
    "/api/client/forgot-password": {
      "post": {
        "tags": ["clients"], "summary": "Solicitar recuperación de contraseña", "security": [],
        "description": "Respuesta SIEMPRE genérica ('Si el usuario existe se enviara un email'): jamás revela existencia. Crea JWT de recuperación HS512 (30m), lo guarda CIFRADO en client_credentials.recovery_token y envía un email con el link (PLATFORM_URL + token).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username"], "properties": { "username": { "type": "string" } } } } } },
        "responses": { "200": { "description": "true (genérico)" } }
      }
    },
    "/api/client/reset-password": {
      "post": {
        "tags": ["clients"], "summary": "Restablecer contraseña con el token cifrado", "security": [],
        "description": "Token cifrado = exactamente el valor guardado en recovery_token (uso único). Al cambiar, la contraseña se hashea bcrypt y se limpia el token. Los hashes de sesión previos quedan invalidados al requerir nuevo login.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["recovery_token", "password"], "properties": { "recovery_token": { "type": "string" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "true" }, "403": { "description": "Token inválido/expirado/ya usado" } }
      }
    },
    "/api/smtp-server/add": {
      "post": {
        "tags": ["smtp-server"], "summary": "Agregar servidor SMTP al catálogo", "security": [{ "bearerAuth": [] }],
        "description": "Requiere ConfigurationExistsGuard (la configuración de plataforma debe existir antes).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["provider", "host", "port"], "properties": { "provider": { "type": "string" }, "host": { "type": "string" }, "port": { "type": "integer" }, "auth_type": { "type": "string", "default": "basic" } } } } } },
        "responses": { "200": { "description": "true" } }
      }
    },
    "/api/email/send": {
      "post": {
        "tags": ["email"], "summary": "Enviar un correo", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "AuthGuard DUAL: Bearer JWT **o** X-API-Key. Requiere ConfigurationExistsGuard. Persiste el email (QUEUED → uuid v4 generado por Postgres + NX-short code), intenta enviar con el SMTP de la configuración global, registra log por intento (SUCCESS/WARNING/ERROR) y entra a la máquina de estados con reintentos automáticos (max_retries, retry_interval_seconds).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["from", "to", "subject"], "properties": { "from": { "type": "string", "format": "email" }, "to": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }, "subject": { "type": "string" }, "html": { "type": "string" }, "text": { "type": "string" }, "attachments": { "type": "array", "items": { "$ref": "#/components/schemas/EmailAttachment" } } } } } } },
        "responses": { "200": { "description": "SendEmailResultDTO { email_uuid (v4), short_code, state, attempts }" }, "403": { "description": "No autenticado o sin configuración" } }
      }
    },
    "/api/email/diffuse": {
      "post": {
        "tags": ["email"], "summary": "Difusión masiva (1–500 destinatarios)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Autenticación DUAL. Verifica el presupuesto diario restante (daily_send_limit − enviados del día) ANTES de persistir; encola cada fila QUEUED y el scheduler los saca FIFO respetando el presupuesto.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["to", "subject"], "properties": { "to": { "type": "array", "items": { "type": "string", "format": "email" }, "minItems": 1, "maxItems": 500 }, "subject": { "type": "string" }, "html": { "type": "string" }, "text": { "type": "string" } } } } } },
        "responses": { "200": { "description": "{ queued, short_codes: string[] }", "content": { "application/json": { "schema": { "type": "object", "properties": { "queued": { "type": "integer" }, "short_codes": { "type": "array", "items": { "type": "string" } } } } } } }, "4xx": { "description": "Presupuesto diario insuficiente o error de validación" } }
      }
    },
    "/api/email": {
      "get": {
        "tags": ["email"], "summary": "Listado paginado de correos", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [ { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["QUEUED", "SENDING", "SENT", "WARNING", "FAILED", "RETRYING"] } }, { "name": "id_client", "in": "query", "schema": { "type": "integer" } }, { "name": "from_date", "in": "query", "schema": { "type": "string", "format": "date-time" } }, { "name": "to_date", "in": "query", "schema": { "type": "string", "format": "date-time" } }, { "name": "short_code", "in": "query", "schema": { "type": "string" } }, { "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100 } }, { "name": "ai_intent", "in": "query", "schema": { "$ref": "#/components/schemas/AiIntent" }, "description": "Solo respuestas clasificadas con esta intención IA" } ],
        "responses": { "200": { "description": "PaginateBaseDTO<EmailListItemDTO[]>; cada ítem incluye `ai_intent` (string|null)" } }
      }
    },
    "/api/email/{emailId}": {
      "get": {
        "tags": ["email"], "summary": "Detalle de un correo con historial de intentos", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "`emailId` acepta el uuid v4 O el short code (NX-XXXXXXX). Incluye `direction` (SENT/RECEIVED), `parent_email_uuid` (nombre del hilo), metadata de adjuntos y `ai_analysis` (AiAnalysis|null, solo respuestas RECEIVED analizadas).",
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string", "description": "UUID v4 o short code NX-…" } } ],
        "responses": { "200": { "description": "EmailDetailDTO (logs por intento)" }, "404": { "description": "No existe" } }
      }
    },
    "/api/email/{emailId}/retry": {
      "post": {
        "tags": ["email"], "summary": "Reintento de un email puntual (un click)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "POST con el id del correo en el path. Nota: no re-chequea el presupuesto diario (decisión de diseño).",
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "SendEmailResultDTO" }, "404": { "description": "No existe" } }
      }
    },
    "/api/email/{emailId}/attachments/{attachmentIndex}": {
      "get": {
        "tags": ["email"], "summary": "Descargar base64 de un adjunto", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "attachmentIndex", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "{ filename, content_type, size_bytes, content_base64 }" }, "404": { "description": "Índice fuera de rango" } }
      }
    },
    "/api/email/{emailId}/certificate": {
      "post": {
        "tags": ["certificates"], "summary": "Emitir certificado de envío (idempotente)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Solo correos SENT o WARNING. Congela una evidencia inmutable (JSON canónico con claves ordenadas): identidad del correo, message_id, cada intento con timestamp y servidor SMTP, y la cadena de respuestas. `content_hash` = SHA-256 de `subject + \"\\n\" + body_html + \"\\n\" + body_text` (nulos como cadena vacía); `evidence_hash` = SHA-256 de la evidencia canónica. Si ya existe, devuelve el mismo certificado.",
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string", "description": "UUID v4 o short code NX-…" } } ],
        "responses": { "200": { "description": "Certificado", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/Certificate" } } } } } }, "400": { "description": "El correo no está en estado SENT/WARNING" }, "404": { "description": "No existe o pertenece a otro cliente" } }
      },
      "get": {
        "tags": ["certificates"], "summary": "Obtener el certificado de un correo", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string", "description": "UUID v4 o short code NX-…" } } ],
        "responses": { "200": { "description": "Certificado", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/Certificate" } } } } } }, "404": { "description": "El correo no tiene certificado" } }
      }
    },
    "/api/email/{emailId}/certificate/pdf": {
      "get": {
        "tags": ["certificates"], "summary": "Descargar el certificado en PDF", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "PDF en español generado desde la evidencia almacenada: código, fecha de emisión (UTC y America/Bogota), remitente/destinatarios/asunto, message-id, ambos hashes, tabla cronológica de intentos, cadena de respuestas y URL pública de verificación.",
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string", "description": "UUID v4 o short code NX-…" } } ],
        "responses": { "200": { "description": "Adjunto `certificado-<code>.pdf`", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } } }, "404": { "description": "El correo no tiene certificado" } }
      }
    },
    "/api/email/{emailId}/analyze": {
      "post": {
        "tags": ["ai"], "summary": "Re-ejecutar el análisis IA de una respuesta", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Solo correos RECEIVED. Síncrono; no reenvía webhooks. Una intención UNSUBSCRIBE_REQUEST agrega una supresión UNSUBSCRIBE del remitente.",
        "parameters": [ { "name": "emailId", "in": "path", "required": true, "schema": { "type": "string", "description": "UUID v4 o short code NX-…" } } ],
        "responses": { "200": { "description": "Análisis", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/AiAnalysis" } } } } } }, "400": { "description": "El correo no es una respuesta RECEIVED" }, "503": { "description": "Análisis IA deshabilitado (sin ANTHROPIC_API_KEY) o proveedor no disponible" } }
      }
    },
    "/api/email/inbound": {
      "post": {
        "tags": ["email"], "summary": "Ingesta de respuestas (webhook de proveedor de entrada)", "security": [],
        "description": "Endpoint público de firma: header `X-Nexlify-Inbound-Signature` = HMAC-SHA256 del body crudo con `INBOUND_WEBHOOK_SECRET` (env). Threading por In-Reply-To/References hacia message_id persistido; ingestion idempotente por message_id; adjuntos ≤ 5MB con aislamiento por ítem; los fallos de negocio (no matchear parent) NO cortan la respuesta. Cuando el reply enhebra con un email de un cliente, se encola una entrega webhook por suscripción RECEIVED_REPLY activa (payload con SOLO los campos habilitados). Con `ANTHROPIC_API_KEY` configurada, la respuesta se analiza con IA de forma asíncrona tras persistirse (nunca bloquea ni falla la ingesta) y las entregas RECEIVED_REPLY se encolan al terminar el análisis, con `ai_analysis` para las suscripciones con `include_ai_analysis` (null si el análisis falló).",
        "parameters": [ { "name": "X-Nexlify-Inbound-Signature", "in": "header", "required": true, "schema": { "type": "string", "description": "hex HMAC-SHA256(rawBody, INBOUND_WEBHOOK_SECRET)" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sender"], "properties": { "sender": { "type": "string" }, "message_id": { "type": "string" }, "in_reply_to_message_id": { "type": "string" }, "references": { "type": "string" }, "subject": { "type": "string" }, "body_text": { "type": "string" }, "body_html": { "type": "string" }, "received_at": { "type": "string", "format": "date-time" }, "attachments": { "type": "array", "items": { "type": "object", "required": ["filename", "content"], "properties": { "filename": { "type": "string" }, "contentType": { "type": "string" }, "size": { "type": "integer" }, "content": { "type": "string", "description": "base64" } } } } } } } } },
        "responses": { "200": { "description": "{ received: true, email_uuid, parent_email_uuid, threaded, attachments_ingested, attachments_rejected[] }" }, "401": { "description": "Firma de entrada inválida" } }
      }
    },
    "/api/email-events/subscriptions": {
      "post": {
        "tags": ["email-events"], "summary": "Suscribirse a eventos de correo", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Para clientes que quieren recibir REPLY_RECEIVED / BOUNCE / etc. vía su endpoint webhook, eligiendo qué campos van en el payload de cada evento (por privacidad, default sin body ni adjuntos).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["webhook_endpoint_uuid", "events"], "properties": { "webhook_endpoint_uuid": { "type": "string", "format": "uuid" }, "events": { "type": "array", "items": { "type": "string", "enum": ["RECEIVED_REPLY"] } }, "include_body": { "type": "boolean", "default": false }, "include_dates": { "type": "boolean", "default": true }, "include_sender": { "type": "boolean", "default": true }, "include_recipients": { "type": "boolean", "default": true }, "include_attachments": { "type": "boolean", "default": false }, "include_ai_analysis": { "type": "boolean", "default": false, "description": "RECEIVED_REPLY incluye `ai_analysis`" }, "id_client": { "type": "integer", "description": "solo admin" } } } } } },
        "responses": { "200": { "description": "Suscripción creada (uuid)" } }
      }
    },
    "/api/email-events/subscriptions/my": {
      "get": {
        "tags": ["email-events"], "summary": "Mis suscripciones (admin: todas)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "EmailEventSubscriptionDTO[]" } }
      }
    },
    "/api/email-events/subscriptions/{subscriptionUuid}": {
      "put": {
        "tags": ["email-events"], "summary": "Actualizar suscripción (eventos, campos, is_active)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [ { "name": "subscriptionUuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "events": { "type": "array", "items": { "type": "string" } }, "is_active": { "type": "boolean" }, "include_body": { "type": "boolean" }, "include_dates": { "type": "boolean" }, "include_sender": { "type": "boolean" }, "include_recipients": { "type": "boolean" }, "include_attachments": { "type": "boolean" }, "include_ai_analysis": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "true" }, "404": { "description": "No existe" } }
      }
    },
    "/api/webhooks": {
      "post": {
        "tags": ["webhooks"], "summary": "Registrar endpoint webhook del cliente (secret único)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Devuelve el secret una sola vez. Todo POST a ese URL entra con headers X-Nexlify-Event / X-Nexlify-Delivery / X-Nexlify-Signature (HMAC-SHA256 del body EXACTO usando el secret).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "url", "description": "IsUrl: requiere TLD o IP. En dev usar http://127.0.0.1:port/path" }, "id_client": { "type": "integer", "description": "solo admin" } } } } } },
        "responses": { "200": { "description": "WebhookEndpointDTO con secret (una sola vez)" } }
      }
    },
    "/api/webhooks/my": {
      "get": {
        "tags": ["webhooks"], "summary": "Mis endpoints webhook (sin secret)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "WebhookEndpointDTO[] sin secret" } }
      }
    },
    "/api/webhooks/{endpointUuid}": {
      "put": {
        "tags": ["webhooks"], "summary": "Actualizar url / is_active del endpoint", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [ { "name": "endpointUuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "url": { "type": "string", "format": "url" }, "is_active": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "true" }, "404": { "description": "No existe" } }
      }
    },
    "/api/webhooks/{endpointUuid}/deliveries": {
      "get": {
        "tags": ["webhooks"], "summary": "Historial paginado de entregas del endpoint", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Más recientes primero. Solo el propietario o un admin.",
        "parameters": [ { "name": "endpointUuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } } ],
        "responses": { "200": { "description": "PaginateBaseDTO<WebhookDelivery[]>", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "type": "object", "properties": { "total_items": { "type": "integer" }, "page": { "type": "integer" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookDelivery" } } } } } } } } }, "403": { "description": "Endpoint de otro cliente" }, "404": { "description": "No existe" } }
      }
    },
    "/api/webhooks/deliveries/{deliveryId}/redeliver": {
      "post": {
        "tags": ["webhooks"], "summary": "Reencolar una entrega", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Reinicia la MISMA fila (attempt 0, ok/status_code/error en null, next_retry_at = ahora); el scheduler la reenvía con su payload almacenado en el siguiente ciclo (≤30 s).",
        "parameters": [ { "name": "deliveryId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[1-9][0-9]*$" } } ],
        "responses": { "200": { "description": "{ queued: true }", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/RedeliverResult" } } } } } }, "403": { "description": "Entrega de otro cliente o endpoint inactivo" }, "404": { "description": "No existe" } }
      }
    },
    "/api/webhooks/{endpointUuid}/test": {
      "post": {
        "tags": ["webhooks"], "summary": "Enviar un evento de prueba firmado (ping)", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "POST síncrono de `{ event: \"ping\", endpoint_uuid, sent_at }` con los mismos headers que una entrega real (`X-Nexlify-Event: ping`, `X-Nexlify-Signature` = HMAC-SHA256 hex del body con el secret del endpoint). No se persiste.",
        "parameters": [ { "name": "endpointUuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
        "responses": { "200": { "description": "Resultado", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/WebhookTestResult" } } } } } }, "403": { "description": "Endpoint de otro cliente" }, "404": { "description": "No existe" } }
      }
    },
    "/api/nexlify-keys/generate": {
      "post": {
        "tags": ["nexlify-keys"], "summary": "Generar API key del cliente", "security": [{ "bearerAuth": [] }],
        "description": "Requiere ContextInterceptor. Previas activas se revocan (una activa por cliente). El API key RAW se expone UNA VEZ (luego solo hash SHA-256 en DB).",
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "id_client": { "type": "integer", "description": "solo admin" } } } } } },
        "responses": { "200": { "description": "{ id_nexlify_key, id_client, api_key, created_at }" } }
      }
    },
    "/api/nexlify-keys/my": {
      "get": {
        "tags": ["nexlify-keys"], "summary": "Mis API keys (enmascaradas)", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OwnedNexlifyKeyDTO[] (api_key_masked)" } }
      }
    },
    "/api/nexlify-keys/{id}/revoke": {
      "put": {
        "tags": ["nexlify-keys"], "summary": "Revocar API key", "security": [{ "bearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "true" }, "404": { "description": "No existe o es ajena" } }
      }
    },
    "/api/users": {
      "post": {
        "tags": ["users"], "summary": "Crear usuario final (de un cliente)", "security": [{ "bearerAuth": [] }],
        "description": "Non-admin fuerza id_client = su cliente; admin puede pasar id_client (default null crea usuario sin client asociado).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "id_client": { "type": "integer" }, "id_type": { "type": "integer" }, "id_number": { "type": "string" }, "first_name": { "type": "string" }, "second_name": { "type": "string" }, "first_surname": { "type": "string" }, "second_surname": { "type": "string" }, "email": { "type": "string" }, "cell_callsign": { "type": "string" }, "cell_phone": { "type": "string" }, "birthdate": { "type": "string", "format": "date" }, "state": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "UserInfoDTO" } }
      },
      "get": {
        "tags": ["users"], "summary": "Listado paginado de usuarios", "security": [{ "bearerAuth": [] }],
        "parameters": [ { "name": "id_client", "in": "query", "schema": { "type": "integer" }, "description": "solo admin" }, { "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "limit", "in": "query", "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "PaginateBaseDTO<UserInfoDTO[]>" } }
      }
    },
    "/api/users/{id_user}": {
      "put": {
        "tags": ["users"], "summary": "Actualizar usuario (perfil + estado)", "security": [{ "bearerAuth": [] }],
        "description": "Admin cualquiera; non-admin solo usuarios de su propio cliente.",
        "parameters": [ { "name": "id_user", "in": "path", "required": true, "schema": { "type": "integer" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "first_name": { "type": "string" }, "second_name": { "type": "string" }, "first_surname": { "type": "string" }, "second_surname": { "type": "string" }, "email": { "type": "string" }, "cell_callsign": { "type": "string" }, "cell_phone": { "type": "string" }, "state": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "UserInfoDTO" } }
      }
    },
    "/api/templates": {
      "post": {
        "tags": ["templates"], "summary": "Crear plantilla (solo admin)", "security": [{ "bearerAuth": [] }],
        "description": "id_template es generado por base de datos con gen_random_uuid(). is_active default true.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "subject": { "type": "string" }, "template": { "type": "string" }, "is_active": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "TemplateInfoDTO (uuid público)" } }
      },
      "get": {
        "tags": ["templates"], "summary": "Listar plantillas (cliente: solo activas)", "security": [{ "bearerAuth": [] }],
        "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "limit", "in": "query", "schema": { "type": "integer" } } ],
        "responses": { "200": { "description": "PaginateBaseDTO<TemplateInfoDTO[]>" } }
      }
    },
    "/api/templates/{id}": {
      "put": {
        "tags": ["templates"], "summary": "Actualizar plantilla (solo admin)", "security": [{ "bearerAuth": [] }],
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "subject": { "type": "string" }, "template": { "type": "string" }, "is_active": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "TemplateInfoDTO" } }
      }
    },
    "/api/configuration/add": {
      "post": {
        "tags": ["configuration"], "summary": "Crear configuración global (admin)", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sender_email", "sender_name", "mail_application_password"], "properties": { "sender_email": { "type": "string" }, "sender_name": { "type": "string" }, "reply_to_email": { "type": "string" }, "mail_application_password": { "type": "string" }, "id_smtp_server": { "type": "integer" }, "daily_send_limit": { "type": "integer" }, "max_retries": { "type": "integer" }, "retry_interval_seconds": { "type": "integer" }, "email_header_text": { "type": "string" }, "email_header_html": { "type": "string" }, "email_header_img_url": { "type": "string" }, "email_footer_text": { "type": "string" }, "email_footer_html": { "type": "string" }, "email_footer_img_url": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Configuración creada (singleton)" }, "409": { "description": "Ya existe una configuración" } }
      }
    },
    "/api/configuration/get": {
      "get": {
        "tags": ["configuration"], "summary": "Leer configuración global", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "NexlifyConfigurationDto" }, "404": { "description": "No existe todavía" } }
      }
    },
    "/api/configuration/update": {
      "put": {
        "tags": ["configuration"], "summary": "Actualizar configuración global (admin)", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "sender_email": { "type": "string" }, "sender_name": { "type": "string" }, "reply_to_email": { "type": "string" }, "mail_application_password": { "type": "string" }, "id_smtp_server": { "type": "integer" }, "daily_send_limit": { "type": "integer" }, "max_retries": { "type": "integer" }, "retry_interval_seconds": { "type": "integer" }, "email_header_text": { "type": "string" }, "email_header_html": { "type": "string" }, "email_header_img_url": { "type": "string" }, "email_footer_text": { "type": "string" }, "email_footer_html": { "type": "string" }, "email_footer_img_url": { "type": "string" } } } } } },
        "responses": { "200": { "description": "NexlifyConfigurationDto" } }
      }
    },
    "/api/stats/overview": {
      "get": {
        "tags": ["stats"], "summary": "Resumen del dashboard", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "description": "Clientes: siempre su propio id_client. Admin: todos o `id_client`. Rango por días UTC inclusivos (por defecto últimos 30 días, máximo 366). `delivery_rate` = (SENT+WARNING)/(SENT+WARNING+FAILED+BOUNCED); `bounce_rate` = BOUNCED/(SENT+WARNING+BOUNCED). El presupuesto es el límite diario global menos los SENT/WARNING de hoy.",
        "parameters": [ { "name": "from", "in": "query", "schema": { "type": "string", "format": "date", "example": "2026-10-07" } }, { "name": "to", "in": "query", "schema": { "type": "string", "format": "date", "example": "2026-11-05" } }, { "name": "id_client", "in": "query", "schema": { "type": "integer" }, "description": "solo admin" } ],
        "responses": { "200": { "description": "Resumen", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/StatsOverview" } } } } } }, "400": { "description": "Rango inválido" }, "403": { "description": "Cliente consultando otro id_client" } }
      }
    },
    "/api/ai/status": {
      "get": {
        "tags": ["ai"], "summary": "Estado de la inteligencia IA", "security": [{ "bearerAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "{ enabled, model }", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/AiStatus" } } } } } } }
      }
    },
    "/api/certificates/{code}/verify": {
      "get": {
        "tags": ["certificates"], "summary": "Verificación pública de un certificado", "security": [],
        "description": "Público. `valid` = la evidencia almacenada sigue produciendo `evidence_hash` al recalcular su SHA-256. No expone contenido del cuerpo; los destinatarios van enmascarados.",
        "parameters": [ { "name": "code", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^NXC-[0-9A-Za-z]+$", "example": "NXC-7fK2pQ9xZa" } } ],
        "responses": { "200": { "description": "Verificación", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/CertificateVerification" } } } } } }, "400": { "description": "Código mal formado" }, "404": { "description": "Certificado no encontrado" } }
      }
    },
    "/api/master/id-types": {
      "get": {
        "tags": ["master"], "summary": "Tipos de identificación", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "MasterDataDTO[] (id + code)" } }
      }
    },
    "/api/verify": {
      "get": {
        "tags": ["verify"], "summary": "Health check", "security": [],
        "responses": { "200": { "description": "'Nexlify provider corriendo exitosamente...'" } }
      }
    },
    "/api/verify/credential-assignment": {
      "get": {
        "tags": ["verify"], "summary": "Validar token de asignación (link del email)", "security": [],
        "parameters": [ { "name": "token", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "Verificación (marca el token como revisado)" }, "4xx": { "description": "Token inválido / ya usado" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "sesión admin (is_admin:true) o client (is_admin:false); binding de IP en el payload" },
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key", "description": "Clave API de cliente (nexlify_keys), solo ruta /api/email/**" }
    },
    "schemas": {
      "EmailAttachment": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "contentType": { "type": "string" },
          "size": { "type": "integer" },
          "content": { "type": "string", "description": "base64 (≤5MB por archivo al ingestar)" }
        }
      },
      "AiIntent": { "type": "string", "enum": ["ACCEPT", "REJECT", "QUESTION", "PAYMENT_PROMISE", "COMPLAINT", "OUT_OF_OFFICE", "UNSUBSCRIBE_REQUEST", "OTHER"] },
      "AiAnalysis": {
        "type": "object",
        "properties": {
          "intent": { "$ref": "#/components/schemas/AiIntent" },
          "sentiment": { "type": "string", "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"] },
          "summary": { "type": "string", "description": "Resumen en español" },
          "entities": { "type": "object", "properties": { "dates": { "type": "array", "items": { "type": "string" } }, "amounts": { "type": "array", "items": { "type": "string" } }, "references": { "type": "array", "items": { "type": "string" } } } },
          "analyzed_at": { "type": "string", "format": "date-time" }
        },
        "example": { "intent": "PAYMENT_PROMISE", "sentiment": "POSITIVE", "summary": "El cliente se compromete a pagar la factura FE-1001 el viernes.", "entities": { "dates": ["viernes 7 de noviembre"], "amounts": ["$1.200.000"], "references": ["FE-1001"] }, "analyzed_at": "2026-11-05T14:03:22.000Z" }
      },
      "AiStatus": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "model": { "type": "string", "example": "claude-opus-5-5" } } },
      "StatsOverview": {
        "type": "object",
        "properties": {
          "range": { "type": "object", "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } } },
          "totals": { "type": "object", "description": "Conteo por cada EmailState (incluye BOUNCED y SUPPRESSED)", "additionalProperties": { "type": "integer" } },
          "delivery_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "bounce_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "replies": { "type": "integer" },
          "daily": { "type": "array", "items": { "type": "object", "properties": { "date": { "type": "string", "format": "date" }, "sent": { "type": "integer" }, "failed": { "type": "integer" }, "received": { "type": "integer" } } } },
          "budget": { "type": "object", "properties": { "daily_limit": { "type": "integer", "nullable": true }, "used_today": { "type": "integer" }, "remaining": { "type": "integer", "nullable": true } } },
          "ai": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "intents": { "type": "object", "additionalProperties": { "type": "integer" } } } }
        },
        "example": { "range": { "from": "2026-11-04", "to": "2026-11-05" }, "totals": { "QUEUED": 0, "SENDING": 0, "SENT": 120, "WARNING": 3, "FAILED": 4, "RETRYING": 1, "RECEIVED": 17, "BOUNCED": 2, "SUPPRESSED": 1 }, "delivery_rate": 0.9535, "bounce_rate": 0.016, "replies": 17, "daily": [{ "date": "2026-11-04", "sent": 60, "failed": 2, "received": 9 }, { "date": "2026-11-05", "sent": 63, "failed": 2, "received": 8 }], "budget": { "daily_limit": 500, "used_today": 63, "remaining": 437 }, "ai": { "enabled": true, "intents": { "ACCEPT": 3, "REJECT": 1, "QUESTION": 5, "PAYMENT_PROMISE": 4, "COMPLAINT": 1, "OUT_OF_OFFICE": 2, "UNSUBSCRIBE_REQUEST": 1, "OTHER": 0 } } }
      },
      "Certificate": {
        "type": "object",
        "properties": {
          "certificate_uuid": { "type": "string", "format": "uuid" },
          "certificate_code": { "type": "string", "example": "NXC-7fK2pQ9xZa" },
          "issued_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string", "description": "SHA-256 hex de subject + \"\\n\" + body_html + \"\\n\" + body_text" },
          "evidence_hash": { "type": "string", "description": "SHA-256 hex de la evidencia canónica" },
          "verify_url": { "type": "string", "format": "uri", "example": "http://localhost:3600/api/certificates/NXC-7fK2pQ9xZa/verify" }
        }
      },
      "CertificateVerification": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean" },
          "certificate_code": { "type": "string" },
          "issued_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string" },
          "evidence_hash": { "type": "string" },
          "email": { "type": "object", "properties": { "short_code": { "type": "string" }, "subject": { "type": "string" }, "to_email": { "type": "string", "example": "j***@c***.com" }, "sent_at": { "type": "string", "format": "date-time", "nullable": true }, "state": { "type": "string", "nullable": true } } }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "properties": {
          "id_delivery": { "type": "string", "example": "44" },
          "event": { "type": "string", "example": "RECEIVED_REPLY" },
          "attempt": { "type": "integer" },
          "ok": { "type": "boolean", "nullable": true },
          "status_code": { "type": "integer", "nullable": true },
          "error": { "type": "string", "nullable": true },
          "next_retry_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "short_code": { "type": "string", "nullable": true }
        }
      },
      "RedeliverResult": { "type": "object", "properties": { "queued": { "type": "boolean", "enum": [true] } } },
      "WebhookTestResult": { "type": "object", "properties": { "ok": { "type": "boolean" }, "status_code": { "type": "integer", "nullable": true }, "error": { "type": "string", "nullable": true }, "duration_ms": { "type": "integer" } }, "example": { "ok": true, "status_code": 200, "error": null, "duration_ms": 182 } }
    }
  }
}
