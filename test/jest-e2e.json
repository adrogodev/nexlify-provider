{
    "moduleFileExtensions": ["js", "json", "ts", "tsx"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "setupFiles": ["./e2e-env.setup.ts"],
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/../src/$1"
    },
    "transformIgnorePatterns": [
        "/node_modules/(?!\\.pnpm/uuid|uuid/)"
    ],
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest",
        "^.+\\.tsx?$": [
            "ts-jest",
            { "compilerOptions": { "jsx": "react-jsx" } }
        ]
    }
}
