# Copy to deploy/.env and fill every secret. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

POSTGRES_USER=nexlify
POSTGRES_PASSWORD=
POSTGRES_DB=nexlify

ADMIN_USER=admin
ADMIN_PASSWORD=

# Public URLs (as seen from the browser / email recipients)
PLATFORM_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3600

JWT_SECRET_KEY=
JWT_EXPIRATION_TIME=8
ENCRYPT_KEY=
INBOUND_WEBHOOK_SECRET=
MAILER_TLS_REJECT_UNAUTHORIZED=true

# Optional: AI reply intelligence (Claude API). Leave empty to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Seed the admin user and the LatAm templates on start (idempotent)
RUN_SEED=true

PROVIDER_PORT=3600
FRONT_PORT=3000
MAILPIT_UI_PORT=8025
