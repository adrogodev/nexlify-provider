{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn"
			},
			"style": {
				"useNodejsImportProtocol": "off",
				"noNonNullAssertion": "off",
				"useImportType": "off"
			}
		},
		"ignore": [
			"src/generated/**",
			"src/presentation/**",
			"dist/**"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 4,
		"lineEnding": "lf",
		"ignore": [
			"src/generated/**",
			"dist/**"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	},
	"files": {
		"ignore": [
			"node_modules/**",
			"dist/**",
			"coverage/**"
		]
	}
}